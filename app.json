{
  "expo": {
    "name": "Beach Buddy",
    "slug": "expoWater",
    "version": "1.0.9",
    "orientation": "portrait",
    "icon": "./assets/expo-images/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/expo-images/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffff00"
