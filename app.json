      "bundleIdentifier": "com.lw1066.expoWater"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/expo-images/adaptive-icon.png",
        "backgroundColor": "#ff0000"
      },
      "package": "com.lw1066.expoWater"
    },
    "web": {
      "favicon": "./assets/expo-images/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "dddfdc31-b102-4953-a36b-511cccfd13a1"
      }
    },
    "plugins": [
      "expo-asset"
    ]
  }
